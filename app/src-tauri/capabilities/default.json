{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения главного окна: выбор журнала и папки, открытие папки журналов в проводнике, настройки. Сети, shell и широких файловых областей нет (FR-33).",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/Documents/bytetap" },
        { "path": "$HOME/Documents/bytetap/**" }
      ]
    },
    "store:default"
  ]
}
