// Ресурс `bytetap.exe`: иконка приложения и VERSIONINFO (U1-AC1, NFR-7).
//
// Компилируется `build.rs` только для Windows MSVC: ресурс линкуется в exe, поэтому в
// свойствах файла видна версия, а в проводнике и на панели задач — иконка bytetap.
// Номера версий приходят с командной строки (`BT_VERSION_COMMA`, `BT_VERSION`): их
// берёт из `CARGO_PKG_VERSION` тот же `build.rs`, что и версию в журнале запуска.
// Заголовков Windows файл не включает: `rc.exe` и `llvm-rc` собирают его без SDK.
//
// Иконка — собственная иконка проекта из v0.1.0 (`assets/icon.ico`, лицензия MIT).
// `CompanyName` не указывается: проект личный, а не компания.

#ifndef BT_VERSION_COMMA
#define BT_VERSION_COMMA 0,0,0,0
#endif

#ifndef BT_VERSION
#define BT_VERSION "0.0.0"
#endif

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION BT_VERSION_COMMA
PRODUCTVERSION BT_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "bytetap"
            VALUE "FileVersion", BT_VERSION
            VALUE "InternalName", "bytetap"
            VALUE "LegalCopyright", "Copyright (c) 2026 Vladislav Chmelyuk"
            VALUE "OriginalFilename", "bytetap.exe"
            VALUE "ProductName", "bytetap"
            VALUE "ProductVersion", BT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
